# HelpCode 权限配置示例（复制为 settings.yaml 或 settings.local.yaml 使用）
# 三层配置：用户级 ~/.helpcode/settings.yaml、项目级 .helpcode/settings.yaml、
#          本地级 .helpcode/settings.local.yaml（本地级优先级最高，已 gitignore）

# 启动默认权限模式：default / acceptEdits / plan / bypassPermissions
default_mode: default

# 权限规则：工具名(模式)，allow 放行、deny 拦截
# 模式支持精确匹配与 glob（* 通配，** 仅对文件路径有意义）
permissions:
  allow:
    - "Bash(git *)"
    - "Write(src/**)"
  deny:
    - "Bash(rm *)"
